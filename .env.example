CHEF_DATABASE_URL=postgresql+psycopg://chef:local-development-only@127.0.0.1:56432/chef
CHEF_VAULT_ROOT=./vault
# Replace both placeholders; never use these values on an exposed server.
CHEF_API_KEYS={"replace-with-a-random-owner-token-at-least-24-characters":{"user_id":"owner","role":"reviewer"}}
CHEF_POLL_SECONDS=10
CHEF_SYNC_ENABLED=false
CHEF_MODEL_ENABLED=false
CHEF_MODEL_NAME=gpt-6-luna
# Project key takes precedence over the ambient OPENAI_API_KEY. Never commit a real key.
CHEF_OPENAI_API_KEY=
CHEF_MODEL_TIMEOUT_SECONDS=20
CHEF_MODEL_MAX_OUTPUT_TOKENS=400
CHEF_MODEL_CALLS_PER_MINUTE=30
CHEF_MODEL_USER_CALLS_PER_MINUTE=10
